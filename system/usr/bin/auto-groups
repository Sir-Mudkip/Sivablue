#!/usr/bin/env bash

# Add every wheel member to the docker and libvirt groups.
#
# Runs on every boot rather than once per machine. usermod -aG is idempotent,
# so repeating it costs nothing, whereas the previous state-file gate meant a
# user added to wheel after first boot never got the groups -- surfacing much
# later as an unexplained permission error with no obvious cause.

set -uo pipefail

# Ensure a group exists. systemd-sysusers creates docker and libvirt from
# /usr/lib/sysusers.d/sivablue-groups.conf and populates /usr/lib/group in the
# process; the /usr/lib/group copy is the fallback for a machine whose
# sysusers run has not happened yet.
append_group() {
  local group_name="$1"

  if getent group "$group_name" >/dev/null 2>&1; then
    return 0
  fi

  if grep -q "^${group_name}:" /usr/lib/group 2>/dev/null; then
    echo "Appending ${group_name} to /etc/group"
    grep "^${group_name}:" /usr/lib/group >>/etc/group
    return 0
  fi

  # Previously this failed silently: the fallback read /usr/lib/group, which
  # did not carry either group, so a missing group stayed missing and the
  # usermod below failed with a far less obvious message.
  echo "Group ${group_name} is missing and absent from /usr/lib/group" >&2
  return 1
}

append_group docker || exit 1
append_group libvirt || exit 1

mapfile -t wheelarray < <(getent group wheel | cut -d ":" -f 4 | tr ',' '\n' | grep -v '^$')

# First boot runs before any user exists. Exit non-zero so the unit's
# Restart=on-failure brings us back in 30s, rather than declaring success and
# never running again.
if [[ ${#wheelarray[@]} -eq 0 ]]; then
    echo "No wheel members yet; will retry."
    exit 1
fi

for user in "${wheelarray[@]}"; do
  usermod -aG docker,libvirt "$user"
done

echo "Added ${#wheelarray[@]} wheel member(s) to docker,libvirt"
